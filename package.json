{
  "name": "leaf-stream",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-db.sh",
    "sync:sim": "node scripts/sync-sim.mjs",
    "check:sim": "node scripts/sync-sim.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/three": "0.170.0",
    "eslint": "9.17.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.7",
    "vitest": "3.0.5"
  }
}
